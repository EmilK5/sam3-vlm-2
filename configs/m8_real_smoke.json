{
  "sam3_model": "facebook/sam3",
  "qwen_model": "qwen2.5-vl-72b-instruct",
  "require_cuda": true,
  "compile_sam3": false,
  "budget": {
    "max_qwen_calls": 5,
    "max_sam3_calls": 15,
    "max_sam3_tiles": 64,
    "max_cleanup_calls": 0,
    "max_runtime_seconds": 300
  },
  "tiling": {
    "grid_rows": 2,
    "grid_cols": 2,
    "overlap_ratio": 0.15,
    "tile_min_size": 256
  },
  "bootstrap": {
    "locked_context_prompt": "tree canopy",
    "locked_context_threshold": 0.4,
    "locked_context_fallback_full_image": true,
    "enable_pseudoexemplar_refinement": true,
    "pseudoexemplar_max_count": 5,
    "pseudoexemplar_min_score": 0.6
  },
  "association": {
    "enable_iom_dedup": true,
    "iom_match_threshold": 0.9,
    "new_node_iom_threshold": 0.9,
    "tiled_nms_iom_threshold": 0.9
  },
  "belief": {
    "num_confounders": 2
  },
  "cleanup": {
    "cleanup_min_utility": 0.05
  },
  "replanning": {
    "max_replans": 3,
    "min_actions_between_replans": 2
  },
  "seed": 42,
  "output_root": "runs/m8_real_smoke",
  "pilot_sample_limit": 10
}
