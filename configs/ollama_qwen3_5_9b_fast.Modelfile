FROM qwen3.5:9b-q4_K_M

# The pipeline sends two images and a compact planner prompt. The upstream
# model's 256K context is unnecessary here and can reserve substantial memory.
PARAMETER num_ctx 8192

# Defense in depth: the OpenAI client also enforces this output limit.
PARAMETER num_predict 512
PARAMETER temperature 0.2
PARAMETER top_p 0.8
PARAMETER seed 42
